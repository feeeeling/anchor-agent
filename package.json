{
  "name": "anchor-agent",
  "displayName": "Anchor Agent",
  "description": "Asynchronous, anchored AI edits through MCP.",
  "version": "0.1.1",
  "publisher": "feeeeling",
  "private": true,
  "license": "MIT",
  "author": "feeeeling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feeeeling/anchor-agent.git"
  },
  "bugs": {
    "url": "https://github.com/feeeeling/anchor-agent/issues"
  },
  "homepage": "https://github.com/feeeeling/anchor-agent#readme",
  "keywords": [
    "vscode",
    "mcp",
    "agent",
    "ai-editing",
    "code-review"
  ],
  "type": "module",
  "engines": {
    "vscode": "^1.95.0"
  },
  "icon": "media/icon.png",
  "main": "./dist/extension.cjs",
  "bin": {
    "anchor-agent-mcp": "./dist/mcp-server.cjs"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:anchorAgent.createTask",
    "onView:anchorAgent.tasks"
  ],
  "contributes": {
    "commands": [
      {
        "command": "anchorAgent.createTask",
        "title": "Anchor Agent: Rewrite Selection"
      },
      {
        "command": "anchorAgent.reviewTask",
        "title": "Anchor Agent: Review Task"
      },
      {
        "command": "anchorAgent.acceptTask",
        "title": "Anchor Agent: Accept Candidate"
      },
      {
        "command": "anchorAgent.rejectTask",
        "title": "Anchor Agent: Reject Candidate"
      },
      {
        "command": "anchorAgent.copyCandidate",
        "title": "Anchor Agent: Copy Candidate"
      },
      {
        "command": "anchorAgent.openDiff",
        "title": "Anchor Agent: Open Candidate Diff"
      },
      {
        "command": "anchorAgent.continueTask",
        "title": "Anchor Agent: Continue Refining Candidate"
      },
      {
        "command": "anchorAgent.answerClarification",
        "title": "Anchor Agent: Answer Clarification"
      },
      {
        "command": "anchorAgent.retryTask",
        "title": "Anchor Agent: Retry Failed Task"
      },
      {
        "command": "anchorAgent.cancelTask",
        "title": "Anchor Agent: Cancel Task"
      },
      {
        "command": "anchorAgent.copyMcpConfig",
        "title": "Anchor Agent: Copy MCP Configuration"
      }
    ],
    "keybindings": [
      {
        "command": "anchorAgent.createTask",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "anchorAgent.tasks",
          "name": "Anchor Agent Tasks"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "anchorAgent.openDiff",
          "when": "view == anchorAgent.tasks && viewItem =~ /hasCandidate/",
          "group": "1_review@1"
        },
        {
          "command": "anchorAgent.copyCandidate",
          "when": "view == anchorAgent.tasks && viewItem =~ /hasCandidate/",
          "group": "1_review@2"
        },
        {
          "command": "anchorAgent.rejectTask",
          "when": "view == anchorAgent.tasks && viewItem =~ /rejectable/",
          "group": "1_review@3"
        },
        {
          "command": "anchorAgent.cancelTask",
          "when": "view == anchorAgent.tasks && viewItem =~ /cancellable/",
          "group": "2_lifecycle@1"
        }
      ]
    },
    "configuration": {
      "title": "Anchor Agent",
      "properties": {
        "anchorAgent.conflictPolicy": {
          "type": "string",
          "enum": [
            "prompt",
            "autoMergeAndReview",
            "regenerateOnChange"
          ],
          "default": "prompt",
          "description": "How to handle edits made inside an active anchor."
        },
        "anchorAgent.autoDispatch": {
          "type": "boolean",
          "default": true,
          "description": "Automatically dispatch pending instructions when the MCP host supports sampling."
        },
        "anchorAgent.samplingMaxTokens": {
          "type": "number",
          "default": 8192,
          "minimum": 512,
          "maximum": 32768,
          "description": "Maximum output tokens for an automatically dispatched MCP sampling request."
        },
        "anchorAgent.allowWorkspaceReads": {
          "type": "boolean",
          "default": true,
          "description": "Allow connected MCP agents to read files in the current workspace."
        },
        "anchorAgent.allowWorkspaceSearch": {
          "type": "boolean",
          "default": true,
          "description": "Allow connected MCP agents to search the current workspace."
        }
      }
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "watch": "node ./scripts/build.mjs --watch",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "node-diff3": "^3.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
